<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform harness for the Unity-free Core/Application test majority.
       Scope, limits, and the exclude-list maintenance rule are documented in
       Docs/AI/Testing/DOTNET_HARNESS.md. Unity-dependent Edit Mode files are
       excluded explicitly so a new Unity-dependent test breaks this build
       instead of being silently skipped. -->
  <Import Project="UnityOnlyTests.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GuardsDigital.EditModeTests</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Assemblies/CardState/GuardsDigital.Core.CardState.csproj" />
    <ProjectReference Include="Assemblies/Core/GuardsDigital.Core.csproj" />
    <ProjectReference Include="Assemblies/Application/GuardsDigital.Application.csproj" />
    <ProjectReference Include="Assemblies/Network/GuardsDigital.Network.csproj" />
    <ProjectReference Include="Assemblies/Presentation/GuardsDigital.Presentation.csproj" />
    <ProjectReference Include="Assemblies/Pve/GuardsDigital.Pve.csproj" />

    <Compile Include="Shims/**/*.cs" />
    <Compile Include="HarnessTests/**/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/*.cs"
             Exclude="@(UnityOnlyTest)" />
    <!-- W-021. The separate PvE executable's engine-free tests; Unity compiles them as their own
         GuardsDigital.Pve.EditModeTests assembly, so they use public APIs only. -->
    <Compile Include="../../Assets/Tests/PveEditMode/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(HarnessForbiddenAccessProbe)' == 'true'">
    <Compile Include="HarnessProbes/ForbiddenCoreAccess.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../Assets/Resources/Maps/alternate-small-single-lane.json" CopyToOutputDirectory="PreserveNewest" Link="Resources/Maps/alternate-small-single-lane.json" />
    <Content Include="../../Assets/Resources/Maps/green-water-double-lane.json" CopyToOutputDirectory="PreserveNewest" Link="Resources/Maps/green-water-double-lane.json" />
    <Content Include="../../Assets/Resources/Maps/lava-bridge-double-lane.json" CopyToOutputDirectory="PreserveNewest" Link="Resources/Maps/lava-bridge-double-lane.json" />
    <Content Include="../../Assets/Resources/Maps/official-single-lane.json"
             CopyToOutputDirectory="PreserveNewest"
             Link="Resources/Maps/official-single-lane.json" />
  </ItemGroup>

</Project>
