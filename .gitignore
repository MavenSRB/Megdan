# Unity-generated project data
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Local validation output
/tmp/

# Private local card and map references; preserve in place, never commit or distribute
/Docs/Guards of Atlantis II - Tabletopia Cards/
/Docs/Guards of Atlantis II - Map References/

# Private prepared board and hero-token artwork remains local. W-008 explicitly publishes only the
# prepared runtime card faces/shine maps, card backs and spell cards to the private project remote.
/Assets/Resources/Private/*
!/Assets/Resources/Private/Cards/
!/Assets/Resources/Private/Cards.meta
!/Assets/Resources/Private/CardBacks/
!/Assets/Resources/Private/CardBacks.meta
!/Assets/Resources/Private/Spells/
!/Assets/Resources/Private/Spells.meta

# IDE and generated solution files
/.vs/
/.idea/
/.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.iml

# Unity crash and diagnostic output
sysinfo.txt
*.stackdump

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Asset Store publishing tools are not project content
/Assets/AssetStoreTools*

# Cross-platform dotnet test harness build outputs
/Tools/DotnetTests/bin/
/Tools/DotnetTests/obj/
/Tools/DotnetTests/TestResults/

# The harness project file is a tracked deliverable (milestone 6.1t); it must
# override the Unity-generated *.csproj exclusion above
!/Tools/DotnetTests/GuardsDigital.DotnetTests.csproj
!/Tools/DotnetTests/Assemblies/**/*.csproj
/Tools/DotnetTests/Assemblies/**/bin/
/Tools/DotnetTests/Assemblies/**/obj/

# Shared presentation compile probe build outputs
/Tools/PresentationProbe/bin/
/Tools/PresentationProbe/obj/

# The probe project file is a tracked deliverable too, for the same reason: it is
# the ONE shared copy, so a worker never resurrects a stale one out of tmp/
!/Tools/PresentationProbe/PresentationProbe.csproj
