# Unity-generated project data
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Local validation output
/tmp/

# Local source card and map references; preserve in place, never commit or distribute
/Docs/Guards of Atlantis II - Tabletopia Cards/
/Docs/Guards of Atlantis II - Map References/
/Docs/Guards of Atlantis II - Tabletopia Cards.zip
/Publisher-Screenshots/
/*.log

# Prepared runtime artwork is published to the private project remote through Git LFS.
# Keep the parent deny rule so any new category remains excluded until explicitly reviewed.
/Assets/Resources/Private/*
!/Assets/Resources/Private/Megdan/
!/Assets/Resources/Private/Megdan.meta
/Assets/Resources/Private/Megdan/*
!/Assets/Resources/Private/Megdan/main-menu-background.jpg
!/Assets/Resources/Private/Megdan/main-menu-background.jpg.meta
!/Assets/Resources/Private/Cards/
!/Assets/Resources/Private/Cards.meta
!/Assets/Resources/Private/CardBacks/
!/Assets/Resources/Private/CardBacks.meta
!/Assets/Resources/Private/HeroSelection/
!/Assets/Resources/Private/HeroSelection.meta
!/Assets/Resources/Private/Heroes/
!/Assets/Resources/Private/Heroes.meta
!/Assets/Resources/Private/Markers/
!/Assets/Resources/Private/Markers.meta
!/Assets/Resources/Private/OfficialBoard/
!/Assets/Resources/Private/OfficialBoard.meta
/Assets/Resources/Private/OfficialBoard/green-water-double-lane-board.png
/Assets/Resources/Private/OfficialBoard/green-water-double-lane-board.png.meta
/Assets/Resources/Private/OfficialBoard/lava-bridge-double-lane-board.png
/Assets/Resources/Private/OfficialBoard/lava-bridge-double-lane-board.png.meta
/Assets/Resources/Private/OfficialBoard/green-water-double-lane-board.png
/Assets/Resources/Private/OfficialBoard/green-water-double-lane-board.png.meta
/Assets/Resources/Private/OfficialBoard/lava-bridge-double-lane-board.png
/Assets/Resources/Private/OfficialBoard/lava-bridge-double-lane-board.png.meta
